# ------------------------------------------------------------------
# EcoPulse - variáveis de ambiente (copie para .env)
# ------------------------------------------------------------------

# Porta publicada do API Gateway (único ponto de entrada para o app móvel)
PORT=4500
NODE_ENV=development

# PostgreSQL / PostGIS
POSTGRES_USER=ecopulse_user
POSTGRES_PASSWORD=ecopulse_pass
POSTGRES_DB=ECOPULSE_DB
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ------------------------------------------------------------------
# Particionamento geoespacial (sharding horizontal)
# ------------------------------------------------------------------
# Número de partições/filas reports_partition_N (deve ser igual em todos os serviços)
PARTITION_COUNT=4
# Tamanho do prefixo do GeoHash usado para escolher a partição
# (5 chars ≈ quadrante de 4.9km x 4.9km; 4 chars ≈ 39km x 19.5km)
PARTITION_PREFIX_LENGTH=5
# Partições consumidas pela instância do geo-processing-service ("all" ou ex.: "0,2")
PARTITIONS=all

# ------------------------------------------------------------------
# Tolerância a falhas: retries com backoff exponencial antes da DLQ
# ------------------------------------------------------------------
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=2000
# Permite enviar `simulateFailure: true` no POST /api/reports para demonstrar retries/DLQ
FAULT_INJECTION=false

# ------------------------------------------------------------------
# Regra de alerta (alert-service)
# ------------------------------------------------------------------
ALERT_MIN_SEVERITY=3
ALERT_RADIUS_KM=5

# ------------------------------------------------------------------
# Push notifications (notification-service)
# Coloque o JSON da service account do Firebase em ./firebase/service-account.json
# ------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=/usr/src/app/firebase/service-account.json
