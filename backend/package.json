{
  "name": "ecopulse-backend",
  "version": "2.0.0",
  "description": "EcoPulse - Backend distribuído (microsserviços orientados a eventos) para Monitoramento Colaborativo de Riscos Ambientais Urbanos",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "services/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=shared",
    "db:migrate": "npm run db:migrate --workspace=shared",
    "start:ingestion": "npm start --workspace=services/ingestion-service",
    "start:query": "npm start --workspace=services/query-service",
    "start:geo": "npm start --workspace=services/geo-processing-service",
    "start:alert": "npm start --workspace=services/alert-service",
    "start:notification": "npm start --workspace=services/notification-service"
  },
  "keywords": [
    "ecopulse",
    "environmental",
    "monitoring",
    "crowdsourcing",
    "microservices",
    "event-driven"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
